# Normalizar finales de línea
* text=auto eol=lf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Archivos de texto específicos
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Archivos de configuración
.gitattributes text eol=lf
.editorconfig text eol=lf
.prettierrc text eol=lf
.prettierrc.json text eol=lf
.prettierrc.js text eol=lf
.eslintrc* text eol=lf
eslint.config.* text eol=lf

